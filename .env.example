# Required
FISH_API_KEY=your_fish_audio_api_key
FISH_VOICE_ID=your_voice_model_id
GROQ_API_KEY=your_groq_api_key

# Optional model overrides
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
FISH_TTS_MODEL=s2.1-pro-free

# Booking by voice. Leave these out and the voice line still answers questions; a caller who asks to book is sent to the website.
# N8N_BOOKING_BASE is the n8n webhook base, e.g. https://your-instance.app.n8n.cloud/webhook (the server adds booking/slots and booking/book).
# N8N_BOOKING_SECRET is the value of the header-auth credential on the two booking webhooks; N8N_BOOKING_HEADER is that header's name.
N8N_BOOKING_BASE=
N8N_BOOKING_SECRET=
N8N_BOOKING_HEADER=X-Booking-Secret

# Optional: a long random string used to sign the booking dialog's state (defaults to a value derived from GROQ_API_KEY).
VOICE_STATE_SECRET=
